{
  "name": "@slvssb/eas-github-cache",
  "description": "A custom build cache provider for Expo CLI. Uses GitHub to store builds.",
  "version": "1.0.0",
  "dependencies": {
    "@babel/code-frame": "7.23.5",
    "@expo/config": "11.0.6",
    "@expo/spawn-async": "^1.7.2",
    "@octokit/rest": "^21.1.1",
    "chalk": "4.1.2",
    "env-paths": "^3.0.0",
    "expo-module-scripts": "^4.1.6",
    "figures": "3.2.0",
    "fs-extra": "11.2.0",
    "getenv": "1.0.0",
    "log-symbols": "4.1.0",
    "node-fetch": "^3.3.2",
    "octokit": "^4.1.3",
    "semver": "7.5.2",
    "tar": "^7.4.3",
    "terminal-link": "2.1.1",
    "tslib": "2.4.1",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@tsconfig/node18": "18.2.4",
    "@types/babel__code-frame": "7.0.3",
    "@types/bun": "latest",
    "@types/fs-extra": "11.0.4",
    "@types/getenv": "^1.0.0",
    "memfs": "3.4.13",
    "rimraf": "3.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slvssb/eas-github-cache.git"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build-allow-unused": "tsc --project tsconfig.allowUnused.json",
    "watch": "bun run build --watch --preserveWatchOutput",
    "watch-allow-unused": "bun run build-allow-unused --watch --preserveWatchOutput",
    "typecheck": "tsc",
    "prepack": "bun rebuild",
    "rebuild": "rimraf build && bun run build",
    "clean": "rimraf build node_modules"
  },
  "files": [
    "/build"
  ],
  "publishConfig": {
    "access": "public"
  }
}
