{
  "name": "@slvssb/eas-github-cache",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slvssb/eas-github-cache.git"
  },
  "main": "build/index.js",
  "dependencies": {
    "@expo/spawn-async": "^1.8.0",
    "@octokit/rest": "^22.0.1",
    "env-paths": "^4.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "node-fetch": "^3.3.2",
    "tar": "^7.5.22",
    "tslib": "^2.8.1",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "description": "A custom build cache provider for Expo CLI. Uses GitHub to store builds.",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "/build"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "watch": "bun run build --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run rebuild",
    "rebuild": "rimraf build && bun run build",
    "clean": "rimraf build node_modules"
  },
  "types": "build/index.d.ts",
  "peerDependencies": {
    "@expo/config": ">=12 <58"
  }
}
